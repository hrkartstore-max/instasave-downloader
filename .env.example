# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Instagram Login — create an Instagram app in Meta for Developers.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
META_GRAPH_API_VERSION=v26.0
META_INSTAGRAM_SCOPES=instagram_business_basic

# 32-byte random secret (base64 or arbitrary long secret; hashed to AES-256 key).
# Generate with: openssl rand -base64 32
IG_TOKEN_ENCRYPTION_KEY=

# Optional vetted media provider adapter. Server-side credentials only.
# Endpoint must accept POST { "url": "https://www.instagram.com/..." }
# and return { "success": true, "items": [{ "url": "https://cdn.example.com/file.mp4",
# "mediaType": "VIDEO", "mimeType": "video/mp4", "filename": "clip.mp4",
# "thumbnailUrl": "https://cdn.example.com/thumb.jpg" }] }.
MEDIA_PROVIDER_URL=
MEDIA_PROVIDER_TOKEN=
# Exact media CDN hostnames returned by your provider, comma-separated. No wildcards.
MEDIA_PROVIDER_MEDIA_HOSTS=

# Exact HTTPS hostnames for future user-controlled direct media sources.
ALLOWED_MEDIA_HOSTS=
