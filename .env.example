# Hybrid InstaSave configuration. Keep secrets server-side only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta official integration (optional; implement OAuth + permissions before enabling).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Optional vetted provider adapter. Credentials alone do not activate downloading.
MEDIA_PROVIDER_URL=
MEDIA_PROVIDER_TOKEN=

# Comma-separated exact HTTPS hostnames for media URLs hosted by you/your provider.
# Never use wildcards or user-controlled hostnames.
ALLOWED_MEDIA_HOSTS=

# Generate a long random secret before enabling signed downloads.
DOWNLOAD_SIGNING_SECRET=
